[Unit]
Description=Dust's brain (voice and LLM for the Dust wall)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
# edit these two paths and the user
User=dust
WorkingDirectory=/home/dust/dust-mosaico/jetson
EnvironmentFile=/etc/dust.env
ExecStart=/usr/bin/python3 -m dust --port /dev/ttyUSB0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
